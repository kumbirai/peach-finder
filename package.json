{
	"name": "peach-finder",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"predev": "tsx scripts/generate-tokens.ts",
		"dev": "vite dev",
		"prebuild": "tsx scripts/generate-tokens.ts",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env --import tsx server.js",
		"worker": "node --env-file=.env --import tsx src/worker/index.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:bundle": "tsx scripts/check-bundle-size.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"boundaries": "depcruise src --config .dependency-cruiser.cjs",
		"pretest": "tsx scripts/generate-tokens.ts",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test",
		"tokens": "tsx scripts/generate-tokens.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
		"db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.2.8",
		"@fontsource-variable/plus-jakarta-sans": "^5.2.8",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"drizzle-orm": "^0.45.2",
		"pg-boss": "^10.3.3",
		"postgres": "^3.4.9",
		"sanitize-html": "^2.17.0",
		"sharp": "^0.34.4",
		"uuid": "^13.0.0",
		"ws": "^8.18.3",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testcontainers/postgresql": "^11.8.1",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.0",
		"@types/ws": "^8.18.1",
		"dependency-cruiser": "^17.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"testcontainers": "^11.8.1",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"yaml": "^2.8.1"
	}
}
