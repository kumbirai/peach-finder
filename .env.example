# Postgres (application role — SELECT/INSERT/UPDATE/DELETE except audit_log is SELECT/INSERT)
DATABASE_URL=postgres://peach_app:secret@127.0.0.1:5432/peach_finder

# Used by migrate/seed to create schemas, extensions, and grants
DATABASE_URL_MIGRATE=postgres://postgres:secret@127.0.0.1:5432/peach_finder

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=peachfinder
MINIO_SECRET_KEY=peachfinder-dev-secret
MINIO_MEDIA_BUCKET=media
MINIO_IDENTITY_DOCS_BUCKET=identity-docs

# Public app origin (CSRF / WS origin check)
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173

# Paystack (optional — omit to use fake hosted checkout in dev/test)
# PAYSTACK_SECRET_KEY=sk_test_...

# Admin TOTP secret encryption (base64-encoded 32-byte key)
TOTP_ENCRYPTION_KEY=ZGV2LXRvdHAtZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
