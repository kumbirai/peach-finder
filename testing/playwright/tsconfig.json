{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"playwright.config.ts",
		"*.e2e.ts",
		"admin-session.ts",
		"provider-session.ts",
		"seeker-session.ts",
		"live-backend-assert.ts",
		"mailhog.ts",
		"seeding/**/*.ts"
	]
}
